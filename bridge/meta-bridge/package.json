{
  "name": "meta-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "AmanCode local meta-bridge: WhatsApp (Baileys) / Facebook / Instagram local transports. Platform SDKs live ONLY here — never in the AmanCode core.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
