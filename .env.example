# AmanCore environment — copy to `.env` and fill values locally.
# `.env` is git-ignored. Never commit real secrets.

AMANCORE_ENV=development
DATABASE_PATH=storage/aman_core.db
LOG_LEVEL=INFO
SHADOW_RATE=40
MODEL_ROUTER_CONFIG=configs/models.yaml

# --- AI providers (fill when going live) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# --- Owner alerts (Phase 3A: log sink; later: real channel) ---
OWNER_ALERT_CHANNEL=log
OWNER_ALERT_DESTINATION=

# --- Local Meta Bridge (WhatsApp via Baileys) ---
AMANCORE_BRIDGE_TOKEN=
BRIDGE_INGRESS_TOKEN=


# Private owner inbox (hidden web UI for WhatsApp conversations)
# INBOX_PATH_SLUG=ibx-<random hex>
# INBOX_PASSWORD_HASH=pbkdf2$200000$<salt>$<hash>   # generate via amancore.channels.inbox.hash_password
# INBOX_SECRET=<random 32-byte hex>

# GLM (Zhipu BigModel) — OpenAI-compatible endpoint
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
