# AmanCore environment — copy to `.env` and fill values locally.
# `.env` is git-ignored. Never commit real secrets.

AMANCORE_ENV=development
DATABASE_PATH=storage/aman_core.db
LOG_LEVEL=INFO
SHADOW_RATE=40
MODEL_ROUTER_CONFIG=configs/models.yaml

# --- AI providers (fill when going live) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# --- DeepSeek Vision-Exp ONLY (text+image AND voice continuation) ---
# model=deepseek-v4-flash-vision-exp ONLY. Never plain deepseek-v4-flash.
# JPEG/PNG/GIF/WebP only, single image <=32MiB, images in user msgs only.
# Voice transcripts continue via the SAME vision-exp model (text-capable).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# optional override, default is deepseek-v4-flash-vision-exp
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# --- AssemblyAI STT (primary voice understanding, Arabic) ---
# Get key: https://www.assemblyai.com/dashboard/settings/billing
# Header is raw `authorization: <KEY>` (no Bearer). language_code=ar default.
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_API_KEY=

# --- Email channel (SMTP outbound + IMAP inbound poll) ---
# Outbound reuses SMTP_HOST/PORT/USER/PASSWORD below (Gmail: app password —
# rotate it if it ever appeared in logs/transcripts).
# Inbound: IMAP UNSEEN sweep via the `email.poll` job (every 5 min).
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_FROM_NAME=AmanCode
# optional: shared secret if a future inbound-email webhook posts to /webhook/email
# EMAIL_WEBHOOK_SECRET=

# --- Google Calendar (consultation events; optional) ---
# When both are set, bookings create real Calendar events with the customer
# as attendee (share the calendar with the service account first).
# When unset, the system attaches an .ics invite to the confirmation email.
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Owner alerts (Phase 3A: log sink; later: real channel) ---
OWNER_ALERT_CHANNEL=log
OWNER_ALERT_DESTINATION=

# --- Local Meta Bridge (WhatsApp via Baileys) ---
AMANCORE_BRIDGE_TOKEN=
BRIDGE_INGRESS_TOKEN=


# Private owner inbox (hidden web UI for WhatsApp conversations)
# INBOX_PATH_SLUG=ibx-<random hex>
# INBOX_PASSWORD_HASH=pbkdf2$200000$<salt>$<hash>   # generate via amancore.channels.inbox.hash_password
# INBOX_SECRET=<random 32-byte hex>

# GLM (Zhipu BigModel) — OpenAI-compatible endpoint
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
